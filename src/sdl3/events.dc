module sdl3::events;

public import sdl3::types;
public import sdl3::keyboard;
public import sdl3::mouse;

public enum SDL_EventType : u32 {
    SDL_EVENT_FIRST = 0,
    SDL_EVENT_QUIT = 0x100,
    SDL_EVENT_TERMINATING = 0x101,
    SDL_EVENT_LOW_MEMORY = 0x102,
    SDL_EVENT_WILL_ENTER_BACKGROUND = 0x103,
    SDL_EVENT_DID_ENTER_BACKGROUND = 0x104,
    SDL_EVENT_WILL_ENTER_FOREGROUND = 0x105,
    SDL_EVENT_DID_ENTER_FOREGROUND = 0x106,
    SDL_EVENT_LOCALE_CHANGED = 0x107,
    SDL_EVENT_SYSTEM_THEME_CHANGED = 0x108,
    SDL_EVENT_DISPLAY_ORIENTATION = 0x151,
    SDL_EVENT_DISPLAY_ADDED = 0x152,
    SDL_EVENT_DISPLAY_REMOVED = 0x153,
    SDL_EVENT_DISPLAY_MOVED = 0x154,
    SDL_EVENT_DISPLAY_DESKTOP_MODE_CHANGED = 0x155,
    SDL_EVENT_DISPLAY_CURRENT_MODE_CHANGED = 0x156,
    SDL_EVENT_DISPLAY_CONTENT_SCALE_CHANGED = 0x157,
    SDL_EVENT_DISPLAY_USABLE_BOUNDS_CHANGED = 0x158,
    SDL_EVENT_WINDOW_SHOWN = 0x202,
    SDL_EVENT_WINDOW_HIDDEN = 0x203,
    SDL_EVENT_WINDOW_EXPOSED = 0x204,
    SDL_EVENT_WINDOW_MOVED = 0x205,
    SDL_EVENT_WINDOW_RESIZED = 0x206,
    SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED = 0x207,
    SDL_EVENT_WINDOW_METAL_VIEW_RESIZED = 0x208,
    SDL_EVENT_WINDOW_MINIMIZED = 0x209,
    SDL_EVENT_WINDOW_MAXIMIZED = 0x20a,
    SDL_EVENT_WINDOW_RESTORED = 0x20b,
    SDL_EVENT_WINDOW_MOUSE_ENTER = 0x20c,
    SDL_EVENT_WINDOW_MOUSE_LEAVE = 0x20d,
    SDL_EVENT_WINDOW_FOCUS_GAINED = 0x20e,
    SDL_EVENT_WINDOW_FOCUS_LOST = 0x20f,
    SDL_EVENT_WINDOW_CLOSE_REQUESTED = 0x210,
    SDL_EVENT_WINDOW_HIT_TEST = 0x211,
    SDL_EVENT_WINDOW_ICCPROF_CHANGED = 0x212,
    SDL_EVENT_WINDOW_DISPLAY_CHANGED = 0x213,
    SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED = 0x214,
    SDL_EVENT_WINDOW_SAFE_AREA_CHANGED = 0x215,
    SDL_EVENT_WINDOW_OCCLUDED = 0x216,
    SDL_EVENT_WINDOW_ENTER_FULLSCREEN = 0x217,
    SDL_EVENT_WINDOW_LEAVE_FULLSCREEN = 0x218,
    SDL_EVENT_WINDOW_DESTROYED = 0x219,
    SDL_EVENT_WINDOW_HDR_STATE_CHANGED = 0x21a,
    SDL_EVENT_KEY_DOWN = 0x300,
    SDL_EVENT_KEY_UP = 0x301,
    SDL_EVENT_TEXT_EDITING = 0x302,
    SDL_EVENT_TEXT_INPUT = 0x303,
    SDL_EVENT_KEYMAP_CHANGED = 0x304,
    SDL_EVENT_KEYBOARD_ADDED = 0x305,
    SDL_EVENT_KEYBOARD_REMOVED = 0x306,
    SDL_EVENT_TEXT_EDITING_CANDIDATES = 0x307,
    SDL_EVENT_MOUSE_MOTION = 0x400,
    SDL_EVENT_MOUSE_BUTTON_DOWN = 0x401,
    SDL_EVENT_MOUSE_BUTTON_UP = 0x402,
    SDL_EVENT_MOUSE_WHEEL = 0x403,
    SDL_EVENT_MOUSE_ADDED = 0x404,
    SDL_EVENT_MOUSE_REMOVED = 0x405,
    SDL_EVENT_GAMEPAD_AXIS_MOTION = 0x650,
    SDL_EVENT_GAMEPAD_BUTTON_DOWN = 0x651,
    SDL_EVENT_GAMEPAD_BUTTON_UP = 0x652,
    SDL_EVENT_GAMEPAD_ADDED = 0x653,
    SDL_EVENT_GAMEPAD_REMOVED = 0x654,
    SDL_EVENT_GAMEPAD_REMAPPED = 0x655,
    SDL_EVENT_GAMEPAD_TOUCHPAD_DOWN = 0x656,
    SDL_EVENT_GAMEPAD_TOUCHPAD_MOTION = 0x657,
    SDL_EVENT_GAMEPAD_TOUCHPAD_UP = 0x658,
    SDL_EVENT_GAMEPAD_SENSOR_UPDATE = 0x659,
    SDL_EVENT_GAMEPAD_UPDATE_COMPLETE = 0x65a,
    SDL_EVENT_DROP_FILE = 0x1000,
    SDL_EVENT_DROP_TEXT = 0x1001,
    SDL_EVENT_DROP_BEGIN = 0x1002,
    SDL_EVENT_DROP_COMPLETE = 0x1003,
    SDL_EVENT_DROP_POSITION = 0x1004,
    SDL_EVENT_USER = 0x8000,
    SDL_EVENT_LAST = 0xffff,
}

public struct SDL_CommonEvent {
    u32 type;
    u32 reserved;
    u64 timestamp;
}

public struct SDL_DisplayEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_DisplayID displayID;
    i32 data1;
    i32 data2;
}

public struct SDL_WindowEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_WindowID windowID;
    i32 data1;
    i32 data2;
}

public struct SDL_KeyboardEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_WindowID windowID;
    types::SDL_KeyboardID which;
    keyboard::SDL_Scancode scancode;
    keyboard::SDL_Keycode key;
    types::SDL_Keymod mod;
    u16 raw;
    bool down;
    bool repeat;
}

public struct SDL_TextInputEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_WindowID windowID;
    const char* text;
}

public struct SDL_MouseMotionEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_WindowID windowID;
    types::SDL_MouseID which;
    types::SDL_MouseButtonFlags state;
    f32 x;
    f32 y;
    f32 xrel;
    f32 yrel;
}

public struct SDL_MouseButtonEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_WindowID windowID;
    types::SDL_MouseID which;
    u8 button;
    bool down;
    u8 clicks;
    u8 padding;
    f32 x;
    f32 y;
}

public struct SDL_MouseWheelEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_WindowID windowID;
    types::SDL_MouseID which;
    f32 x;
    f32 y;
    mouse::SDL_MouseWheelDirection direction;
    f32 mouse_x;
    f32 mouse_y;
    i32 integer_x;
    i32 integer_y;
}

public struct SDL_GamepadAxisEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_JoystickID which;
    u8 axis;
    u8 padding1;
    u8 padding2;
    u8 padding3;
    i16 value;
    u16 padding4;
}

public struct SDL_GamepadButtonEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
    types::SDL_JoystickID which;
    u8 button;
    bool down;
    u8 padding1;
    u8 padding2;
}

public struct SDL_QuitEvent {
    SDL_EventType type;
    u32 reserved;
    u64 timestamp;
}

public struct SDL_UserEvent {
    u32 type;
    u32 reserved;
    u64 timestamp;
    types::SDL_WindowID windowID;
    i32 code;
    void* data1;
    void* data2;
}

public union SDL_Event {
    u32 type;
    SDL_CommonEvent common;
    SDL_DisplayEvent display;
    SDL_WindowEvent window;
    SDL_KeyboardEvent key;
    SDL_TextInputEvent text;
    SDL_MouseMotionEvent motion;
    SDL_MouseButtonEvent button;
    SDL_MouseWheelEvent wheel;
    SDL_GamepadAxisEvent gaxis;
    SDL_GamepadButtonEvent gbutton;
    SDL_QuitEvent quit;
    SDL_UserEvent user;
    u8[128] padding;
}

public using SDL_EventFilter = bool(*)(void* userdata, SDL_Event* event);

@nomangle public extern void SDL_PumpEvents();
@nomangle public extern bool SDL_HasEvent(u32 type);
@nomangle public extern bool SDL_HasEvents(u32 minType, u32 maxType);
@nomangle public extern void SDL_FlushEvent(u32 type);
@nomangle public extern void SDL_FlushEvents(u32 minType, u32 maxType);
@nomangle public extern bool SDL_PollEvent(SDL_Event* event);
@nomangle public extern bool SDL_WaitEvent(SDL_Event* event);
@nomangle public extern bool SDL_WaitEventTimeout(
    SDL_Event* event,
    i32 timeoutMS
);
@nomangle public extern bool SDL_PushEvent(SDL_Event* event);
@nomangle public extern void SDL_SetEventFilter(
    SDL_EventFilter filter,
    void* userdata
);
@nomangle public extern bool SDL_AddEventWatch(
    SDL_EventFilter filter,
    void* userdata
);
@nomangle public extern void SDL_RemoveEventWatch(
    SDL_EventFilter filter,
    void* userdata
);
@nomangle public extern u32 SDL_RegisterEvents(i32 numevents);
