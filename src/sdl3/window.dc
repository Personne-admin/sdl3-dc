module sdl3::window;

public import sdl3::types;
public import sdl3::video;

public using types::SDL_WindowFlags SDL_WINDOW_FULLSCREEN = 0x0000000000000001;
public using types::SDL_WindowFlags SDL_WINDOW_OPENGL = 0x0000000000000002;
public using types::SDL_WindowFlags SDL_WINDOW_OCCLUDED = 0x0000000000000004;
public using types::SDL_WindowFlags SDL_WINDOW_HIDDEN = 0x0000000000000008;
public using types::SDL_WindowFlags SDL_WINDOW_BORDERLESS = 0x0000000000000010;
public using types::SDL_WindowFlags SDL_WINDOW_RESIZABLE = 0x0000000000000020;
public using types::SDL_WindowFlags SDL_WINDOW_MINIMIZED = 0x0000000000000040;
public using types::SDL_WindowFlags SDL_WINDOW_MAXIMIZED = 0x0000000000000080;
public using types::SDL_WindowFlags SDL_WINDOW_MOUSE_GRABBED = 0x0000000000000100;
public using types::SDL_WindowFlags SDL_WINDOW_INPUT_FOCUS = 0x0000000000000200;
public using types::SDL_WindowFlags SDL_WINDOW_MOUSE_FOCUS = 0x0000000000000400;
public using types::SDL_WindowFlags SDL_WINDOW_EXTERNAL = 0x0000000000000800;
public using types::SDL_WindowFlags SDL_WINDOW_MODAL = 0x0000000000001000;
public using types::SDL_WindowFlags SDL_WINDOW_HIGH_PIXEL_DENSITY = 0x0000000000002000;
public using types::SDL_WindowFlags SDL_WINDOW_MOUSE_CAPTURE = 0x0000000000004000;
public using types::SDL_WindowFlags SDL_WINDOW_MOUSE_RELATIVE_MODE = 0x0000000000008000;
public using types::SDL_WindowFlags SDL_WINDOW_ALWAYS_ON_TOP = 0x0000000000010000;
public using types::SDL_WindowFlags SDL_WINDOW_UTILITY = 0x0000000000020000;
public using types::SDL_WindowFlags SDL_WINDOW_TOOLTIP = 0x0000000000040000;
public using types::SDL_WindowFlags SDL_WINDOW_POPUP_MENU = 0x0000000000080000;
public using types::SDL_WindowFlags SDL_WINDOW_KEYBOARD_GRABBED = 0x0000000000100000;
public using types::SDL_WindowFlags SDL_WINDOW_VULKAN = 0x0000000010000000;
public using types::SDL_WindowFlags SDL_WINDOW_METAL = 0x0000000020000000;
public using types::SDL_WindowFlags SDL_WINDOW_TRANSPARENT = 0x0000000040000000;
public using types::SDL_WindowFlags SDL_WINDOW_NOT_FOCUSABLE = 0x0000000080000000;

public using i32 SDL_WINDOWPOS_UNDEFINED = 0x1FFF0000;
public using i32 SDL_WINDOWPOS_CENTERED = 0x2FFF0000;

public enum SDL_DisplayOrientation : i32 {
    SDL_ORIENTATION_UNKNOWN = 0,
    SDL_ORIENTATION_LANDSCAPE = 1,
    SDL_ORIENTATION_LANDSCAPE_FLIPPED = 2,
    SDL_ORIENTATION_PORTRAIT = 3,
    SDL_ORIENTATION_PORTRAIT_FLIPPED = 4,
}

public struct SDL_DisplayMode {
    types::SDL_DisplayID displayID;
    video::SDL_PixelFormat format;
    i32 w;
    i32 h;
    f32 pixel_density;
    f32 refresh_rate;
    i32 refresh_rate_numerator;
    i32 refresh_rate_denominator;
    types::SDL_DisplayModeData* internal;
}

@nomangle public extern types::SDL_DisplayID* SDL_GetDisplays(i32* count);
@nomangle public extern types::SDL_DisplayID SDL_GetPrimaryDisplay();
@nomangle public extern const char* SDL_GetDisplayName(
    types::SDL_DisplayID displayID
);
@nomangle public extern bool SDL_GetDisplayBounds(
    types::SDL_DisplayID displayID,
    types::SDL_Rect* rect
);
@nomangle public extern bool SDL_GetDisplayUsableBounds(
    types::SDL_DisplayID displayID,
    types::SDL_Rect* rect
);
@nomangle public extern SDL_DisplayOrientation SDL_GetCurrentDisplayOrientation(
    types::SDL_DisplayID displayID
);
@nomangle public extern f32 SDL_GetDisplayContentScale(
    types::SDL_DisplayID displayID
);
@nomangle public extern const SDL_DisplayMode* SDL_GetCurrentDisplayMode(
    types::SDL_DisplayID displayID
);
@nomangle public extern const SDL_DisplayMode* SDL_GetDesktopDisplayMode(
    types::SDL_DisplayID displayID
);

@nomangle public extern types::SDL_Window* SDL_CreateWindow(
    const char* title,
    i32 w,
    i32 h,
    types::SDL_WindowFlags flags
);
@nomangle public extern types::SDL_Window* SDL_CreateWindowWithProperties(
    types::SDL_PropertiesID props
);
@nomangle public extern void SDL_DestroyWindow(types::SDL_Window* window);
@nomangle public extern types::SDL_WindowID SDL_GetWindowID(
    types::SDL_Window* window
);
@nomangle public extern types::SDL_Window* SDL_GetWindowFromID(
    types::SDL_WindowID id
);
@nomangle public extern types::SDL_PropertiesID SDL_GetWindowProperties(
    types::SDL_Window* window
);
@nomangle public extern types::SDL_WindowFlags SDL_GetWindowFlags(
    types::SDL_Window* window
);
@nomangle public extern bool SDL_SetWindowTitle(
    types::SDL_Window* window,
    const char* title
);
@nomangle public extern const char* SDL_GetWindowTitle(
    types::SDL_Window* window
);
@nomangle public extern bool SDL_SetWindowPosition(
    types::SDL_Window* window,
    i32 x,
    i32 y
);
@nomangle public extern bool SDL_GetWindowPosition(
    types::SDL_Window* window,
    i32* x,
    i32* y
);
@nomangle public extern bool SDL_SetWindowSize(
    types::SDL_Window* window,
    i32 w,
    i32 h
);
@nomangle public extern bool SDL_GetWindowSize(
    types::SDL_Window* window,
    i32* w,
    i32* h
);
@nomangle public extern bool SDL_GetWindowSizeInPixels(
    types::SDL_Window* window,
    i32* w,
    i32* h
);
@nomangle public extern f32 SDL_GetWindowDisplayScale(types::SDL_Window* window);
@nomangle public extern f32 SDL_GetWindowPixelDensity(types::SDL_Window* window);
@nomangle public extern bool SDL_SetWindowFullscreen(
    types::SDL_Window* window,
    bool fullscreen
);
@nomangle public extern bool SDL_ShowWindow(types::SDL_Window* window);
@nomangle public extern bool SDL_HideWindow(types::SDL_Window* window);
@nomangle public extern bool SDL_RaiseWindow(types::SDL_Window* window);
@nomangle public extern bool SDL_MaximizeWindow(types::SDL_Window* window);
@nomangle public extern bool SDL_MinimizeWindow(types::SDL_Window* window);
@nomangle public extern bool SDL_RestoreWindow(types::SDL_Window* window);
@nomangle public extern bool SDL_SetWindowResizable(
    types::SDL_Window* window,
    bool resizable
);
@nomangle public extern bool SDL_SetWindowBordered(
    types::SDL_Window* window,
    bool bordered
);
@nomangle public extern types::SDL_DisplayID SDL_GetDisplayForWindow(
    types::SDL_Window* window
);

@nomangle public extern void SDL_free(void* mem);
